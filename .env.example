# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，禁止提交
# 仅存放机密项：API Key 与数据库凭据

# 火山方舟 API Key
ARK_API_KEY=your_ark_api_key_here

# VikingDB IAM 鉴权（rerank 精排接口，不支持方舟 API Key）
VIKINGDB_AK=your_vikingdb_ak_here
VIKINGDB_SK=your_vikingdb_sk_here

# PostgreSQL 凭据（须与 docker-compose.yml 一致）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fin_rag
POSTGRES_USER=fin
POSTGRES_PASSWORD=fin_local_dev

# CrewAI 本地存储子目录名（%LOCALAPPDATA%\CrewAI\ 下的文件夹名）
CREWAI_STORAGE_DIR=fin_analyst_crew
CREWAI_TRACING_ENABLED=false
